# Copy to .env with `make env`, then fill in the keys you need.
# .env is git-ignored.

# General
NODE_ENV=development
# Public URL the browser uses to reach the app (nginx).
PUBLIC_URL=http://localhost:8080
# Port nginx is published on, on the host.
WEB_PORT=8080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hypertube
POSTGRES_USER=hypertube
POSTGRES_PASSWORD=change_me_postgres
# Exposed on the host for debugging (psql). Change if 5432 is taken.
POSTGRES_HOST_PORT=5433

# Auth / crypto
# Generate with: openssl rand -hex 64   (make secrets)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
# Access token lifetime (seconds) / refresh token lifetime (days)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# SMTP (password reset e-mails)
# Dev default points at the bundled MailHog container -> http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Hypertube <no-reply@hypertube.local>"

# OmniAuth / OAuth2 providers
# 42 (mandatory) -> https://profile.intra.42.fr/oauth/applications
# Redirect URI to register: ${PUBLIC_URL}/api/auth/oauth/42/callback
OAUTH_42_CLIENT_ID=
OAUTH_42_CLIENT_SECRET=

# Google (2nd strategy) -> https://console.cloud.google.com/apis/credentials
# Redirect URI: ${PUBLIC_URL}/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub (bonus strategy) -> https://github.com/settings/developers
# Redirect URI: ${PUBLIC_URL}/api/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Discord (bonus strategy) -> https://discord.com/developers/applications
# Redirect URI: ${PUBLIC_URL}/api/auth/oauth/discord/callback
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Public REST API (OAuth2 client credentials)
# Seeded into the database on first migration. Used by POST /api/oauth/token.
API_CLIENT_ID=hypertube-default-client
API_CLIENT_SECRET=change_me_api_client_secret

# Movie metadata
# TMDb (free): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (free): https://www.omdbapi.com/apikey.aspx  (optional fallback)
OMDB_API_KEY=

# Subtitles
# OpenSubtitles REST API key (optional): https://www.opensubtitles.com/consumers
# When absent, only subtitles embedded in the video file are offered.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=Hypertube/1.0

# Torrent engine
# TCP port the peer listener binds inside the container (also published).
TORRENT_PORT=6881
# Max simultaneous peer connections per torrent.
TORRENT_MAX_PEERS=60
# Number of sequential pieces buffered ahead of the playhead.
TORRENT_READAHEAD_PIECES=24
# Fraction of the file to buffer before playback starts.
TORRENT_START_THRESHOLD=0.02
# Where downloaded media lives inside the container.
MEDIA_DIR=/data/media
TORRENT_DIR=/data/torrents
AVATAR_DIR=/data/avatars
# Delete movies not watched for this many days.
MEDIA_RETENTION_DAYS=30
